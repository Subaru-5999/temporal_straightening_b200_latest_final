__pycache__
*.pyc
# test-runtime artifacts, created by `pytest tests/` (hypothesis example database and
# pytest's own cache). Same class of generated file as __pycache__ above: never source.
.hypothesis/
.pytest_cache/
# driver pid file written by run_ccr_pilot.sh (`ccr_<mode>_<timestamp>.pid`); its companion
# `ccr_<mode>_<timestamp>.log` is already covered by the `*.log` rule below. The EXIT trap
# removes it, but a killed driver leaves it behind.
ccr_*.pid
# NOTE: probe_ccr_curvature.py writes its reports to `probe_outputs/`, which the `*outputs*`
# rule below already ignores; no separate rule needed.
figures
*outputs*
data
wandb
checkpoints
*.slurm
*.sh
# keep the B200 helper scripts despite the *.sh ignore above
!setup_b200.sh
!run_train.sh
!run_experiments.sh
!setup_planning.sh
!evaluate.sh
!all_results.sh
!eval_pusht_3seeds.sh
!run_ccr_pilot.sh
# local-only memory/context file (do not commit)
AGENT_MEMORY.md
_paper.txt
*.log
.ipynb_checkpoints/
.train_pid
# Run artifacts, same class as *.log above -- generated on the pod, never source.
# `*.out` is `... 2>&1 | tee probe_ccr_pusht.out`; the CSVs are written into the CWD by
# aggregate_results.py on every invocation. Without these rules the Requirement 5.6 scope
# guard reports them as out-of-scope source changes, which is a false positive that trains
# the reader to ignore a test that exists to catch real violations.
*.out
results_per_seed.csv
results_cells.csv
